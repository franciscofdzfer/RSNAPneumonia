    "# genero la submission con el mejor modelo entrenado\n",
    "from ultralytics import YOLO\n",
    "import pandas as pd\n",
    "\n",
    "# cargo el mejor modelo guardado\n",
    "mejor_modelo = YOLO(f'{RUTA_OUTPUTS}/runs/yolo_rsna/weights/best.pt')\n",
    "\n",
    "# obtengo los ids de test\n",
    "ids_test   = [f.replace('.png', '') for f in os.listdir(RUTA_PNG_TEST)]\n",
    "resultados = []\n",
    "\n",
    "for pid in ids_test:\n",
    "    ruta_png = f'{RUTA_PNG_TEST}/{pid}.png'\n",
    "    # inferencia sobre la imagen\n",
    "    preds = mejor_modelo.predict(ruta_png, conf=0.3, verbose=False)\n",
    "    pred  = preds[0]\n",
    "\n",
    "    if len(pred.boxes) == 0:\n",
    "        # sin detecciones — string vacío\n",
    "        pred_str = ''\n",
    "    else:\n",
    "        partes = []\n",
    "        for box in pred.boxes:\n",
    "            # obtengo confianza y coordenadas en formato xywh\n",
    "            conf      = box.conf.item()\n",
    "            x, y, w, h = box.xywh[0].tolist()\n",
    "            # escalo de 512 a 1024 que es el tamaño original\n",
    "            escala = 1024 / 512\n",
    "            x = int(x * escala)\n",
    "            y = int(y * escala)\n",
    "            w = int(w * escala)\n",
    "            h = int(h * escala)\n",
    "            partes.append(f'{conf:.4f} {x} {y} {w} {h}')\n",
    "        pred_str = ' '.join(partes)\n",
    "\n",
    "    resultados.append({'patientId': pid, 'PredictionString': pred_str})\n",
    "\n",
    "df_sub = pd.DataFrame(resultados)\n",
    "df_sub.to_csv(f'{RUTA_OUTPUTS}/submission_yolo.csv', index=False)\n",
    "print(f'submission generada: {len(df_sub)} filas')\n",
    "df_sub.head()"
   ]
  },
